# FAGE Backend Environment

# JWT auth (change in production)
FAGE_JWT_SECRET=fage-dev-jwt-secret-change-in-production
FAGE_JWT_EXPIRE_MINUTES=480

# Database — default SQLite; for Supabase Postgres:
# 1. Get the connection string from Supabase (Settings -> Database -> Connection string -> URI)
# 2. Make sure it starts with postgresql+psycopg2:// instead of postgresql://
# DATABASE_URL=postgresql+psycopg2://postgres.xxxxxx:YOUR_PASSWORD@aws-0-xxxxxx.pooler.supabase.com:6543/postgres
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20

# Optional: NVIDIA NIM API Key for LLM-powered SAR report generation
NVIDIA_API_KEY=

# Demo logins (see app/auth.py):
#   admin / admin123      (role: admin)
#   analyst / analyst123  (role: analyst)
#   auditor / auditor123  (role: auditor)
